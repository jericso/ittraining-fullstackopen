{
  "name": "notes-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "json-server -p 3001 db.json",
    "build:ui": "rm -rf dist && cd ../notes-frontend/ && npm run build",
    "deploy-local": "rm -rf /var/www/localhost_81/html/* && cp -r dist/* /var/www/localhost_81/html",
    "deploy-dev": "ssh jericso@dev.prolegoma.com \"rm -rf /var/www/dev.prolegoma.com:81/html/*\" && scp -r ./dist/* jericso@dev.prolegoma.com:/var/www/dev.prolegoma.com:81/html",
    "deploy-local:full": "npm run build:ui && npm run deploy-local",
    "deploy-dev:full": "npm run build:ui && npm run deploy-dev"
  },
  "dependencies": {
    "axios": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "json-server": "^0.17.4",
    "vite": "^6.2.0"
  }
}
